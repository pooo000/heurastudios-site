{%- comment -%}
  The site's pages for search engines (Nov 24, 2026, with the OpenAI migration page): every page and blog post, except
  the old waitlist page (kept only for old links), the legal pages' dated old versions, and anything not meant to be indexed. robots.txt points here.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.html_pages %}
{%- unless p.url == '/waitlist/' or p.url contains '/20' or p.url contains '404' or p.sitemap == false %}
  <url><loc>{{ site.url }}{{ p.url }}</loc></url>
{%- endunless %}
{%- endfor %}
{%- for post in site.posts %}
  <url><loc>{{ site.url }}{{ post.url }}</loc><lastmod>{{ post.date | date: '%Y-%m-%d' }}</lastmod></url>
{%- endfor %}
</urlset>
